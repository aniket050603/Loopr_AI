{
  "name": "financial-dashboard-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API for the Financial Analytics Dashboard assignment",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
